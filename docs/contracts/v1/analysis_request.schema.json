{
  "$defs": {
    "SubtitleSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "style": {
          "const": "yellow_pop",
          "default": "yellow_pop",
          "title": "Style",
          "type": "string"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "middle"
          ],
          "title": "Position",
          "type": "string"
        },
        "max_words_per_line": {
          "default": 4,
          "maximum": 6,
          "minimum": 2,
          "title": "Max Words Per Line",
          "type": "integer"
        },
        "font_scale": {
          "default": 1.0,
          "maximum": 1.5,
          "minimum": 0.7,
          "title": "Font Scale",
          "type": "number"
        },
        "text_color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "highlight_color": {
          "default": "#FFFF00",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight Color",
          "type": "string"
        },
        "outline_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_width": {
          "default": 5,
          "maximum": 8,
          "minimum": 0,
          "title": "Outline Width",
          "type": "integer"
        }
      },
      "title": "SubtitleSettings",
      "type": "object"
    },
    "VideoSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "aspect": {
          "default": "source",
          "enum": [
            "source",
            "vertical",
            "horizontal"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "remove_silence": {
          "default": false,
          "title": "Remove Silence",
          "type": "boolean"
        },
        "watermark_text": {
          "default": "",
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\x00-\\x1f]*$",
          "title": "Watermark Text",
          "type": "string"
        },
        "watermark_position": {
          "default": "bottom_right",
          "enum": [
            "top_left",
            "top_right",
            "bottom_left",
            "bottom_right"
          ],
          "title": "Watermark Position",
          "type": "string"
        },
        "header_enabled": {
          "default": false,
          "title": "Header Enabled",
          "type": "boolean"
        },
        "header_name": {
          "default": "",
          "maxLength": 60,
          "title": "Header Name",
          "type": "string"
        },
        "header_title": {
          "default": "",
          "maxLength": 120,
          "title": "Header Title",
          "type": "string"
        }
      },
      "title": "VideoSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.3.0",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "duration_mode": {
      "enum": [
        "exact",
        "range"
      ],
      "title": "Duration Mode",
      "type": "string"
    },
    "target_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target S"
    },
    "min_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min S"
    },
    "max_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max S"
    },
    "top_k": {
      "maximum": 100,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "niche": {
      "minLength": 1,
      "title": "Niche",
      "type": "string"
    },
    "instructions": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instructions"
    },
    "subtitle_settings": {
      "$ref": "#/$defs/SubtitleSettings"
    },
    "video_settings": {
      "$ref": "#/$defs/VideoSettings"
    }
  },
  "required": [
    "asset_id",
    "duration_mode",
    "top_k",
    "niche"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
