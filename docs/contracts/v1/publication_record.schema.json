{
  "$defs": {
    "MetricSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "collection_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Id"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "age_hours": {
          "minimum": 0,
          "title": "Age Hours",
          "type": "number"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "source": {
          "enum": [
            "connector",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "quality": {
          "enum": [
            "available",
            "unavailable",
            "estimated",
            "corrected"
          ],
          "title": "Quality",
          "type": "string"
        },
        "source_reference": {
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "snapshot_id",
        "publication_id",
        "observed_at",
        "age_hours",
        "metric_name",
        "metric_definition",
        "source",
        "quality",
        "source_reference"
      ],
      "title": "MetricSnapshot",
      "type": "object"
    },
    "Publication": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "revision_id": {
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "account": {
          "minLength": 1,
          "title": "Account",
          "type": "string"
        },
        "posted_at": {
          "format": "date-time",
          "title": "Posted At",
          "type": "string"
        },
        "final_asset_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Asset Id"
        },
        "publication_url": {
          "pattern": "^https?://[^\\s]+$",
          "title": "Publication Url",
          "type": "string"
        },
        "external_video_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Video Id"
        },
        "editorial_status": {
          "const": "published",
          "default": "published",
          "title": "Editorial Status",
          "type": "string"
        }
      },
      "required": [
        "publication_id",
        "revision_id",
        "platform",
        "account",
        "posted_at",
        "publication_url"
      ],
      "title": "Publication",
      "type": "object"
    },
    "PublicationCollectionRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "collection_id": {
          "minLength": 1,
          "title": "Collection Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "status": {
          "enum": [
            "requested",
            "collecting",
            "completed",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "connector_version": {
          "minLength": 1,
          "title": "Connector Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "trigger": {
          "const": "explicit_user_action",
          "title": "Trigger",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "collection_id",
        "publication_id",
        "requested_at",
        "status",
        "connector_version",
        "request_id",
        "trigger"
      ],
      "title": "PublicationCollectionRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/Publication"
    },
    "collections": {
      "items": {
        "$ref": "#/$defs/PublicationCollectionRun"
      },
      "title": "Collections",
      "type": "array"
    },
    "snapshots": {
      "items": {
        "$ref": "#/$defs/MetricSnapshot"
      },
      "title": "Snapshots",
      "type": "array"
    }
  },
  "required": [
    "publication",
    "collections",
    "snapshots"
  ],
  "title": "PublicationRecord",
  "type": "object"
}
