{
  "$defs": {
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.3.0",
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "duration_mode": {
          "enum": [
            "exact",
            "range"
          ],
          "title": "Duration Mode",
          "type": "string"
        },
        "target_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target S"
        },
        "min_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min S"
        },
        "max_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max S"
        },
        "top_k": {
          "maximum": 100,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "niche": {
          "minLength": 1,
          "title": "Niche",
          "type": "string"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "subtitle_settings": {
          "$ref": "#/$defs/SubtitleSettings"
        },
        "video_settings": {
          "$ref": "#/$defs/VideoSettings"
        }
      },
      "required": [
        "asset_id",
        "duration_mode",
        "top_k",
        "niche"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "ClipCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Features",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "rank_score": {
          "title": "Rank Score",
          "type": "number"
        },
        "versions": {
          "$ref": "#/$defs/ModelRun"
        },
        "duration_compliance": {
          "default": "requested",
          "enum": [
            "requested",
            "alternative"
          ],
          "title": "Duration Compliance",
          "type": "string"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "candidate_id",
        "asset_id",
        "features",
        "evidence_ids",
        "reasons",
        "limitations",
        "rank_score",
        "versions"
      ],
      "title": "ClipCandidate",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "interpretation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation"
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "evidence_id",
        "asset_id",
        "observation",
        "provenance"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Transcript",
          "type": "array"
        },
        "visual_events": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Visual Events",
          "type": "array"
        },
        "audio_events": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Audio Events",
          "type": "array"
        },
        "quality": {
          "items": {
            "type": "string"
          },
          "title": "Quality",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "transcript",
        "visual_events",
        "audio_events",
        "quality",
        "provenance"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "MediaAsset": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "tracks": {
          "items": {
            "enum": [
              "audio",
              "video"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        },
        "local_path": {
          "minLength": 1,
          "title": "Local Path",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "source_uri",
        "content_hash",
        "duration_s",
        "tracks",
        "local_path"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "ModelRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "rules_version": {
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "feature_schema": {
          "minLength": 1,
          "title": "Feature Schema",
          "type": "string"
        },
        "dataset_version": {
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "model_version",
        "rules_version",
        "feature_schema",
        "dataset_version",
        "settings"
      ],
      "title": "ModelRun",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "artifact_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "original_offset_s": {
          "minimum": 0,
          "title": "Original Offset S",
          "type": "number"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "source_uri",
        "artifact_hash",
        "original_offset_s",
        "settings"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SubtitleSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "style": {
          "const": "yellow_pop",
          "default": "yellow_pop",
          "title": "Style",
          "type": "string"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "middle"
          ],
          "title": "Position",
          "type": "string"
        },
        "max_words_per_line": {
          "default": 4,
          "maximum": 6,
          "minimum": 2,
          "title": "Max Words Per Line",
          "type": "integer"
        },
        "font_scale": {
          "default": 1.0,
          "maximum": 1.5,
          "minimum": 0.7,
          "title": "Font Scale",
          "type": "number"
        },
        "text_color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "highlight_color": {
          "default": "#FFFF00",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight Color",
          "type": "string"
        },
        "outline_color": {
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Outline Color",
          "type": "string"
        },
        "outline_width": {
          "default": 5,
          "maximum": 8,
          "minimum": 0,
          "title": "Outline Width",
          "type": "integer"
        }
      },
      "title": "SubtitleSettings",
      "type": "object"
    },
    "VideoSettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "aspect": {
          "default": "source",
          "enum": [
            "source",
            "vertical",
            "horizontal"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "remove_silence": {
          "default": false,
          "title": "Remove Silence",
          "type": "boolean"
        },
        "watermark_text": {
          "default": "",
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\x00-\\x1f]*$",
          "title": "Watermark Text",
          "type": "string"
        },
        "watermark_position": {
          "default": "bottom_right",
          "enum": [
            "top_left",
            "top_right",
            "bottom_left",
            "bottom_right"
          ],
          "title": "Watermark Position",
          "type": "string"
        },
        "header_enabled": {
          "default": false,
          "title": "Header Enabled",
          "type": "boolean"
        },
        "header_name": {
          "default": "",
          "maxLength": 60,
          "title": "Header Name",
          "type": "string"
        },
        "header_title": {
          "default": "",
          "maxLength": 120,
          "title": "Header Title",
          "type": "string"
        }
      },
      "title": "VideoSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "asset": {
      "$ref": "#/$defs/MediaAsset"
    },
    "request": {
      "$ref": "#/$defs/AnalysisRequest"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ClipCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "asset",
    "request",
    "evidence",
    "candidates",
    "limitations"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
